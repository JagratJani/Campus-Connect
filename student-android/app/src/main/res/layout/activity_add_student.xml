<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Full Name *"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="#1E293B"
            android:hint="e.g. Aarav Patel"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address *"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStudentEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="#1E293B"
            android:hint="e.g. aarav@campus.edu"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Course / Branch *"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStudentCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="#1E293B"
            android:hint="e.g. Information Technology"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semester (1-12) *"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStudentSemester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:background="#1E293B"
            android:hint="e.g. 4"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnSubmitStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4F46E5"
            android:padding="14dp"
            android:text="Create Student"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
