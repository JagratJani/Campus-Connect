              "raw": "{\n  \"name\": \"Neha Verma\",\n  \"email\": \"neha.verma@campus.edu\",\n  \"role\": \"Student\",\n  \"department\": \"Information Technology\"\n}"
            },
            "url": { "raw": "{{USER_SERVICE_URL}}/users", "host": ["{{USER_SERVICE_URL}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('User created with assigned ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('Neha Verma');",
                  "    pm.expect(json.id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jagrat Jani (Updated)\",\n  \"department\": \"Advanced AI & Robotics\"\n}"
            },
            "url": { "raw": "{{USER_SERVICE_URL}}/users/1", "host": ["{{USER_SERVICE_URL}}"], "path": ["users", "1"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
