  "item": [
    {
      "name": "1. User Service Direct Endpoints",
      "item": [
        {
          "name": "GET All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{USER_SERVICE_URL}}/users", "host": ["{{USER_SERVICE_URL}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array of users', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{USER_SERVICE_URL}}/users/1", "host": ["{{USER_SERVICE_URL}}"], "path": ["users", "1"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns user with id 1', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(1);",
                  "    pm.expect(json.name).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
