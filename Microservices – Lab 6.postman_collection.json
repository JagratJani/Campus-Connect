    {
      "name": "3. Order Service & Service-to-Service Communication",
      "item": [
        {
          "name": "GET All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{ORDER_SERVICE_URL}}/orders", "host": ["{{ORDER_SERVICE_URL}}"], "path": ["orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns list of orders', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Order (Valid User & Product - 201 Created)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"productId\": 101,\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "{{ORDER_SERVICE_URL}}/orders", "host": ["{{ORDER_SERVICE_URL}}"], "path": ["orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Order has verified user and product details', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.userId).to.eql(1);",
                  "    pm.expect(json.productId).to.eql(101);",
                  "    pm.expect(json.quantity).to.eql(2);",
                  "    pm.expect(json.totalPrice).to.eql(50.00);",
                  "    pm.expect(json.user.name).to.be.a('string');",
                  "    pm.expect(json.product.name).to.be.a('string');",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Order with Invalid User ID (404 Not Found)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 9999,\n  \"productId\": 101,\n  \"quantity\": 1\n}"
            },
            "url": { "raw": "{{ORDER_SERVICE_URL}}/orders", "host": ["{{ORDER_SERVICE_URL}}"], "path": ["orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });",
                  "pm.test('Controlled error indicates user not found', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include('9999');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Order when Dependency Down (503 Service Unavailable)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"productId\": 101,\n  \"quantity\": 1\n}"
            },
            "url": { "raw": "{{ORDER_SERVICE_URL}}/orders", "host": ["{{ORDER_SERVICE_URL}}"], "path": ["orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Controlled 503 Service Unavailable when dependency is down', function () {",
                  "    pm.expect([503, 201]).to.include(pm.response.code);",
                  "    if (pm.response.code === 503) {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.error).to.include('unavailable');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
