# API Gateway — Service Registry (Part B: Configuration-Based Service Discovery)
# =============================================================================
# This file defines the service registry for the API Gateway.
# The gateway reads these values at startup — no service URL is hard-coded
# inside route-handling code.
#
# To change a service's location, edit this file (or set the matching
# environment variable in docker-compose / cloud platform) and restart
# the gateway — no code change required.
# =============================================================================

# Gateway port
GATEWAY_PORT=3000

# Service Registry: locations of downstream microservices
# In Docker Compose these resolve via Docker DNS (service-name:port).
# In cloud deployments, replace with the actual public service URLs.
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
